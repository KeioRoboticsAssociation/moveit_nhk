# Solenoid Status Message
# Real-time status of solenoid outputs on STM32

std_msgs/Header header          # Header with timestamp
uint8 solenoid_count            # Number of solenoids configured (max 8)
bool[8] solenoid_states         # Boolean array of output states
                                # false = OFF
                                # true = ON
uint32 timestamp_ms             # STM32 timestamp in milliseconds
