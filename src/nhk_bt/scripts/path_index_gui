#!/usr/bin/env python3

import tkinter as tk

import rclpy
from rclpy.action import ActionClient
from rclpy.node import Node

from nhk_action_interfaces.action import PathIndex
from std_msgs.msg import Int32MultiArray
from trajectory_msgs.msg import JointTrajectory, JointTrajectoryPoint


class PathIndexGuiNode(Node):
    def __init__(self) -> None:
        super().__init__("path_index_gui")
        self._action_name = self.declare_parameter("action_name", "/path_index").value
        self._trajectory_topic = self.declare_parameter("trajectory_topic", "/joint_trajectory").value
        self._slider6_joint_name = self.declare_parameter("slider6_joint_name", "Slider 1_3").value
        self._goal_place_topic = self.declare_parameter("goal_place_topic", "/goal_place").value
        self._goal_place_size = int(self.declare_parameter("goal_place_size", 9).value)
        self._push_value = float(self.declare_parameter("push_value", 1.00).value)
        self._back_value = float(self.declare_parameter("back_value", -1.00).value)
        self._move_duration = float(self.declare_parameter("move_duration_sec", 0.2).value)
        self._client = ActionClient(self, PathIndex, self._action_name)
        self._trajectory_pub = self.create_publisher(JointTrajectory, self._trajectory_topic, 10)
        self._goal_place_pub = self.create_publisher(Int32MultiArray, self._goal_place_topic, 10)
        self._status_callback = None

    def set_status_callback(self, callback) -> None:
        self._status_callback = callback

    def _set_status(self, text: str) -> None:
        if self._status_callback is not None:
            self._status_callback(text)
        else:
            self.get_logger().info(text)

    def send_index(self, index: int) -> None:
        if not self._client.wait_for_server(timeout_sec=0.2):
            self._set_status("Action server が見つかりません")
            self.get_logger().warn("PathIndex action server is not available")
            return

        goal_msg = PathIndex.Goal()
        goal_msg.path_index = index
        self._set_status(f"送信中: index={index}")
        future = self._client.send_goal_async(goal_msg)
        future.add_done_callback(lambda f: self._goal_response_callback(f, index))

    def _goal_response_callback(self, future, index: int) -> None:
        goal_handle = future.result()
        if not goal_handle.accepted:
            self._set_status(f"拒否: index={index}")
            return
        self._set_status(f"受理: index={index}")
        result_future = goal_handle.get_result_async()
        result_future.add_done_callback(lambda f: self._result_callback(f, index))

    def _result_callback(self, future, index: int) -> None:
        result = future.result().result
        if result.success:
            self._set_status(f"成功: index={index}")
        else:
            self._set_status(f"失敗: index={index}")

    def send_push(self) -> None:
        self._publish_slider6_trajectory(self._push_value)
        self._set_status(f"Push送信: {self._push_value:.4f}")

    def send_back(self) -> None:
        self._publish_slider6_trajectory(self._back_value)
        self._set_status(f"Back送信: {self._back_value:.4f}")

    def send_goal_place(self, place: int) -> None:
        k = max(1, self._goal_place_size)
        index = int(place) - 1
        one_hot = [0] * k
        if 0 <= index < k:
            one_hot[index] = 1

        msg = Int32MultiArray()
        msg.data = one_hot
        self._goal_place_pub.publish(msg)
        self._set_status(f"goal_place送信: place={place}, one_hot={one_hot}")

    def _publish_slider6_trajectory(self, position: float) -> None:
        point = JointTrajectoryPoint()
        point.positions = [position]
        sec = max(0.0, self._move_duration)
        point.time_from_start.sec = int(sec)
        point.time_from_start.nanosec = int((sec - int(sec)) * 1_000_000_000)

        traj = JointTrajectory()
        traj.joint_names = [self._slider6_joint_name]
        traj.points = [point]
        self._trajectory_pub.publish(traj)

    def spin_once(self) -> None:
        if rclpy.ok():
            rclpy.spin_once(self, timeout_sec=0.0)


def build_gui(node: PathIndexGuiNode) -> tk.Tk:
    root = tk.Tk()
    root.title("Path Index GUI")
    root.geometry("840x420")
    root.resizable(False, False)

    frame = tk.Frame(root, padx=12, pady=12)
    frame.pack(fill=tk.BOTH, expand=True)
    frame.grid_columnconfigure(0, weight=1, uniform="pane")
    frame.grid_columnconfigure(1, weight=1, uniform="pane")

    left_frame = tk.Frame(frame)
    left_frame.grid(row=0, column=0, sticky="nsew")
    right_frame = tk.Frame(frame)
    right_frame.grid(row=0, column=1, sticky="nsew", padx=(12, 0))

    status_var = tk.StringVar(value=f"Action server: {node._action_name}")
    node.set_status_callback(status_var.set)

    title = tk.Label(left_frame, text="PathIndex 送信 (3x2)", font=("Helvetica", 14, "bold"))
    title.grid(row=0, column=0, columnspan=2, pady=(0, 10))

    # 指定配置:
    # 0: 左下, 1: 左中, 2: 左上, 3: 右上, 4: 右中, 5: 右下
    buttons = [
        (2, "左上\nindex=2", 1, 0),
        (3, "右上\nindex=3", 1, 1),
        (1, "左真ん中\nindex=1", 2, 0),
        (4, "右真ん中\nindex=4", 2, 1),
        (0, "左下\nindex=0", 3, 0),
        (5, "右下\nindex=5", 3, 1),
    ]

    for index, text, row, col in buttons:
        btn = tk.Button(
            left_frame,
            text=text,
            width=16,
            height=3,
            font=("Helvetica", 11),
            command=lambda i=index: node.send_index(i),
        )
        btn.grid(row=row, column=col, padx=8, pady=8, sticky="nsew")

    for col in range(2):
        left_frame.grid_columnconfigure(col, weight=1)

    status = tk.Label(left_frame, textvariable=status_var, anchor="w", font=("Helvetica", 10))
    status.grid(row=4, column=0, columnspan=2, sticky="ew", pady=(12, 8))

    push_button = tk.Button(
        left_frame,
        text="Push",
        width=16,
        height=2,
        font=("Helvetica", 12, "bold"),
        command=node.send_push,
    )
    push_button.grid(row=5, column=0, padx=8, pady=6, sticky="nsew")

    back_button = tk.Button(
        left_frame,
        text="Back",
        width=16,
        height=2,
        font=("Helvetica", 12, "bold"),
        command=node.send_back,
    )
    back_button.grid(row=5, column=1, padx=8, pady=6, sticky="nsew")

    keypad_title = tk.Label(right_frame, text="goal_place", font=("Helvetica", 14, "bold"))
    keypad_title.grid(row=0, column=0, columnspan=3, pady=(0, 10))

    keypad_numbers = [
        (1, 1, 0), (2, 1, 1), (3, 1, 2),
        (4, 2, 0), (5, 2, 1), (6, 2, 2),
        (7, 3, 0), (8, 3, 1), (9, 3, 2),
    ]
    for number, row, col in keypad_numbers:
        key = tk.Button(
            right_frame,
            text=str(number),
            width=8,
            height=3,
            font=("Helvetica", 12, "bold"),
            command=lambda n=number: node.send_goal_place(n),
        )
        key.grid(row=row, column=col, padx=6, pady=6, sticky="nsew")

    for col in range(3):
        right_frame.grid_columnconfigure(col, weight=1)

    def poll_ros() -> None:
        node.spin_once()
        root.after(20, poll_ros)

    root.after(20, poll_ros)
    return root


def main() -> None:
    rclpy.init()
    node = PathIndexGuiNode()
    root = build_gui(node)
    try:
        root.mainloop()
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()
