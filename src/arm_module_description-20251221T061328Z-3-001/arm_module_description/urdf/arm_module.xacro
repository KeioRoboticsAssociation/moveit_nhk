<joint name="Slider 1" type="prismatic">
  <origin xyz="-0.503878 1.289649 0.143054" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="Link1_1"/>
  <axis xyz="0.0 0.0 1.0"/>
  <limit upper="0.11" lower="-0.125" effort="100" velocity="100"/>
</joint>

<joint name="Slider 3" type="prismatic">
  <origin xyz="0.028568 0.0588 0.094967" rpy="0 0 0"/>
  <parent link="Link2_1"/>
  <child link="Link3_1"/>
  <axis xyz="0.0 -0.0 1.0"/>
