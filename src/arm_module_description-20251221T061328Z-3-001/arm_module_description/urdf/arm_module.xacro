</joint>

<joint name="Revolute 2" type="continuous">
  <origin xyz="-0.0935 0.0285 0.1285" rpy="0 0 0"/>
  <parent link="Link1_1"/>
  <child link="Link2_1"/>
  <axis xyz="-0.0 1.0 0.0"/>
