<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ikeyaMD_wizard</name>
  <version>1.0.0</version>
  <description>GUI application for ikeyaMD RS485 motor control and configuration</description>
  <maintainer email="ymrs1122@gmail.com">imanoob</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>stm32_mavlink_msgs</depend>
  <depend>stm32_mavlink_uart</depend>

  <exec_depend>python3-pyqt5</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
